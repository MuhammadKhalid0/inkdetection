{
  "model": {
    "name": "nnformer",
    "feature_size": 16,
    "capacity": "S",
    "patch_size": [
      1,
      4,
      4
    ],
    "gv_bottleneck": true,
    "skip_attention": true,
    "drop_path": 0.1,
    "cssa": false,
    "sr_pb": false,
    "vffc_bottleneck": true
